meta {
  name: Create Order - Token Without Bearer Prefix
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Authorization: {{accessToken}}
}

body:json {
  {
    "itemId": 999,
    "quantity": 1
  }
}

docs {
  Sends the raw token without the "Bearer " scheme. itemId 999 is used so
  the request never changes stock: if auth is (wrongly) accepted the API
  answers 404 "Item not found" instead of 401.
}

tests {
  test("status is 401 (scheme must be 'Bearer')", function () {
    expect(res.status).to.equal(401);
  });
}
