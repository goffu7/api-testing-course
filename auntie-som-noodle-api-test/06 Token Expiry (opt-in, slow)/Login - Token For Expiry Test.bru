meta {
  name: Login - Token For Expiry Test
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  if (String(bru.getEnvVar("runExpiryTest")) !== "true") {
    bru.runner.skipRequest();
  }
}

script:post-response {
  bru.setVar("expiryToken", res.body.accessToken);
  bru.setVar("expiryIssuedAt", Date.now());
  bru.setVar("expiryLifetimeSec", res.body.expiresIn);
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("token lifetime is announced", function () {
    expect(res.body.expiresIn).to.be.a("number").and.be.above(0);
  });
}
