meta {
  name: Login - Wrong Password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "not-hungry"
  }
}

tests {
  test("status is 401", function () {
    expect(res.status).to.equal(401);
  });

  test("no token is issued", function () {
    expect(res.body).to.not.have.property("accessToken");
  });

  test("error message is returned", function () {
    expect(res.body.error).to.be.a("string").and.not.be.empty;
  });
}
