meta {
  name: Login - Valid Credentials
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  // Store the token in the environment so every later request can use it
  if (res.status === 200 && res.body && res.body.accessToken) {
    bru.setEnvVar("accessToken", res.body.accessToken);
  }
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("accessToken is a non-empty UUID string", function () {
    expect(res.body.accessToken).to.be.a("string");
    expect(res.body.accessToken).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
  });

  test("expiresIn is 3600 seconds", function () {
    expect(res.body.expiresIn).to.equal(3600);
  });

  test("token was saved to the environment", function () {
    expect(bru.getEnvVar("accessToken")).to.equal(res.body.accessToken);
  });
}
