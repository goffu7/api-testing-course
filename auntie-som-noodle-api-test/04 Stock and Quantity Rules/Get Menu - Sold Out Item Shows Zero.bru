meta {
  name: Get Menu - Sold Out Item Shows Zero
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/menu
  body: none
  auth: none
}

script:post-response {
  // nothing to store
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("sold out item has stock exactly 0", function () {
    const b = res.body.find(i => i.id === Number(bru.getVar("itemBId")));
    expect(b.stock).to.equal(0);
  });
}
