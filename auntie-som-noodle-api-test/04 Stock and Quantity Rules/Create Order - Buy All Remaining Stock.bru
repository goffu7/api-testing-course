meta {
  name: Create Order - Buy All Remaining Stock
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "itemId": {{itemBId}},
    "quantity": {{itemBStock}}
  }
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("status is created", function () {
    expect(res.body.status).to.equal("created");
  });

  test("totalPrice equals menu price x quantity", function () {
    const expected = Number(bru.getVar("itemBPrice")) * Number(bru.getVar("itemBStock"));
    expect(res.body.totalPrice).to.equal(expected);
  });
}
