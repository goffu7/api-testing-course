meta {
  name: Create Order - Missing Quantity
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "itemId": {{itemBId}}
  }
}

tests {
  test("server does not crash (no 5xx)", function () {
    expect(res.status).to.be.below(500);
  });

  test("status is 400 (request rejected)", function () {
    expect(res.status).to.equal(400);
  });

  test("no order is created", function () {
    expect(res.body).to.not.have.property("orderId");
  });

  test("an error message is returned", function () {
    expect(res.body.error).to.be.a("string").and.not.be.empty;
  });

  test("error response is JSON, not an HTML page", function () {
    expect(res.headers["content-type"]).to.include("application/json");
  });

  test("no stack trace or source code is leaked", function () {
    const text = typeof res.body === "string" ? res.body : JSON.stringify(res.body);
    expect(text).to.not.match(/Traceback|Werkzeug|app\.py/);
  });
}
